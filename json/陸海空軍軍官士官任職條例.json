      {
        "id": "article-16",
        "articleNumber": "16",
        "displayNumber": "第 16 條",
        "title": null,
        "plainText": "軍官、士官得依作戰之需要，實施軍種間相互配置任職。",
        "structureId": null,
        "content": [
          {
            "type": "paragraph",
            "number": null,
            "text": "軍官、士官得依作戰之需要，實施軍種間相互配置任職。"
          }
        ],
        "metadata": {
          "source": "全國法規資料庫 陸海空軍軍官士官任職條例（PDF：陸海空軍軍官士官任職條例.pdf）",
          "lastModified": "2022-06-15"
        }
